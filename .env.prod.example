# Variabili del COMPOSE di produzione (docker-compose.prod.yml).
# Copia in `.env` NELLA ROOT del repo (NON è laravel/.env — quello è l'env dell'app):
#   cp .env.prod.example .env
# e compila i valori. Docker Compose legge questo .env per sostituire ${...} nel compose.
#
# ATTENZIONE: i valori qui DEVONO combaciare con laravel/.env (stesse password/chiavi):
#   POSTGRES_* ⇄ DB_* di laravel/.env ; MEILI_MASTER_KEY ⇄ MEILISEARCH_KEY di laravel/.env.

# Dominio pubblico (senza schema). Caddy emette il certificato TLS per questo host e per www.
APP_DOMAIN=arkvel.example

# Email per Let's Encrypt (avvisi di scadenza certificati).
ACME_EMAIL=admin@arkvel.example

# PostgreSQL (il container li usa per creare il DB; devono combaciare con DB_* di laravel/.env).
POSTGRES_DB=arkvel
POSTGRES_USER=arkvel
POSTGRES_PASSWORD=   # genera una password robusta

# Meilisearch master key (deve combaciare con MEILISEARCH_KEY di laravel/.env).
MEILI_MASTER_KEY=    # genera una chiave robusta (NON 'masterKey')
