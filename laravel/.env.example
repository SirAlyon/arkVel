APP_NAME=ArkVel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=arkvel
DB_USERNAME=arkvel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@arkvel.eu"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem / S3 (EU data residency in produzione)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Ricerca (Laravel Scout + Meilisearch)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

# Google Calendar (Cal-5). Lascia vuoto per tenere la sincronizzazione Google INERTE
# (UI disabilitata). Per abilitarla: crea credenziali OAuth "Web application" nella
# Google Cloud Console, abilita la Calendar API e registra l'URI di callback in
# GOOGLE_CALENDAR_REDIRECT_URI (es. https://tuo-dominio/calendar/google/callback).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Laravel Reverb (websocket self-hosted per il realtime: messaggi live + campanella).
# Genera credenziali di sviluppo con `php artisan reverb:install` oppure imposta valori
# tuoi. In Docker il server gira nel servizio `reverb` (0.0.0.0:8080); il browser si
# connette a localhost:8080. Niente account esterni.
# Valori di SVILUPPO (non segreti): il realtime funziona out-of-the-box col servizio
# `reverb` del docker-compose. In PRODUZIONE rigenerane di univoci e tienili nell'.env.
REVERB_APP_ID=arkvel
REVERB_APP_KEY=arkvel-reverb-key
REVERB_APP_SECRET=arkvel-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
