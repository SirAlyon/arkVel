# ArkVel — env dell'APP per la PRODUZIONE con Docker (docker-compose.prod.yml).
# Sul server:  cp laravel/.env.prod.example laravel/.env  e compila le righe «← COMPILA».
# Gli hostname (postgres/redis/meilisearch/reverb) sono i nomi dei servizi Docker: lasciali così.
# Le righe segnate «= .env di root» DEVONO combaciare col file .env nella root del repo.

APP_NAME=ArkVel
APP_ENV=production
APP_KEY=                                  # ← generata sul server: php artisan key:generate
APP_DEBUG=false
APP_URL=https://TUODOMINIO                 # ← COMPILA (es. https://arkvel.eu)

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Fuori da local un Host diverso da questi riceve 400. Metti dominio + www.
APP_TRUSTED_HOSTS=TUODOMINIO,www.TUODOMINIO  # ← COMPILA
# Dietro Caddy (reverse-proxy): necessario per IP reale (rate limit) e schema https.
TRUSTED_PROXIES=*
# Versione dell'informativa registrata alla registrazione (aggiornala a ogni revisione).
PRIVACY_POLICY_VERSION=2026-11

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (PostgreSQL in Docker) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=arkvel
DB_USERNAME=arkvel
DB_PASSWORD=                               # ← COMPILA = POSTGRES_PASSWORD del .env di root

# --- Sessione / code / cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# Coda dedicata alle conversioni immagini (worker queue-media nel compose).
MEDIA_QUEUE=media

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Posta (SMTP reale: Postmark/SES/Mailgun…). Configura SPF/DKIM/DMARC sul dominio. ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=                                 # ← COMPILA
MAIL_PORT=587                              # ← COMPILA (secondo il provider)
MAIL_USERNAME=                             # ← COMPILA
MAIL_PASSWORD=                             # ← COMPILA
MAIL_FROM_ADDRESS="no-reply@TUODOMINIO"    # ← COMPILA
MAIL_FROM_NAME="${APP_NAME}"

# --- Ricerca (Meilisearch in Docker) ---
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=                           # ← COMPILA = MEILI_MASTER_KEY del .env di root

# --- Mappa (OpenFreeMap). Lascia i default; per tile self-hosted scommenta e cambia. ---
#MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
#MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/fiord

# --- Google Calendar (opzionale: lascia vuoto per tenerlo inerte, o configuralo da /admin). ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# --- Stripe / donazioni (vuoto = widget donazioni nascosto; si può anche impostare da /admin).
# Webhook da creare su Stripe verso https://TUODOMINIO/stripe/webhook. ---
STRIPE_KEY=                                # ← COMPILA quando attivi le donazioni
STRIPE_SECRET=                             # ← COMPILA
STRIPE_WEBHOOK_SECRET=                     # ← COMPILA
CASHIER_CURRENCY=eur

# --- Reverb (websocket) dietro Caddy: SERVER interno, CLIENT pubblico (vedi docs/DEPLOY.md) ---
REVERB_APP_ID=                             # ← COMPILA (valore univoco random, non quello di dev)
REVERB_APP_KEY=                            # ← COMPILA (random)
REVERB_APP_SECRET=                         # ← COMPILA (random)
# Il backend pubblica gli eventi verso il container Reverb (NON via dominio: niente hairpin):
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Il browser si connette in wss sul 443 attraverso Caddy (ESPLICITO, non ${REVERB_HOST}).
# IMPORTANTE: questi finiscono negli asset → impostali PRIMA di `npm run build`.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=TUODOMINIO                 # ← COMPILA (solo host, senza https://)
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
